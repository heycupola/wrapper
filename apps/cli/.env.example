# CLI runtime.
# Point these at ONE environment at a time:
#   local -> convex dev URL + ws://localhost:8080 + http://localhost:3000
#   dev   -> wrapper-dev convex + wss://wrapper-relay-dev.fly.dev + dev web origin
#   prod  -> prod convex + wss://wrapper-relay-prod.fly.dev + prod web origin
# See ENVIRONMENTS.md for the full matrix.
NODE_ENV="development"
CI=

WRAPPER_CONVEX_URL="https://your-project.convex.cloud"
WRAPPER_RELAY_URL="ws://localhost:8080"
WRAPPER_AUTH_ORIGIN="http://localhost:3000"
WRAPPER_HUD="on"

# Opt-in WebRTC P2P fast path for relay sessions. Off by default (relay is used).
# When "1"/"true"/"on", host and viewer try a direct data channel (lower latency)
# and fall back to the relay if it can't be established. Requires testing across
# real networks. STUN is public; P2P exposes peer IPs to each other (WebRTC norm).
WRAPPER_P2P="false"

# Optional logging and telemetry
WRAPPER_LOG="info"
WRAPPER_LOG_FILE=""
WRAPPER_TELEMETRY="false"
WRAPPER_TELEMETRY_URL="https://telemetry.wrapper.sh"
