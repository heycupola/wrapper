{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Wrapper",
  "colors": {
    "primary": "#2D57F0",
    "light": "#84A1FF",
    "dark": "#2D57F0"
  },
  "background": {
    "color": {
      "light": "#EEF0F2",
      "dark": "#0B0D10"
    },
    "decoration": "grid"
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg"
  },
  "favicon": "/assets/favicon.svg",
  "css": "/assets/custom.css",
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://wrapper.sh"
      },
      {
        "label": "Support",
        "href": "https://wrapper.sh/support"
      },
      {
        "type": "discord",
        "label": "Discord",
        "href": "https://discord.gg/heycupola"
      },
      {
        "label": "X",
        "href": "https://x.com/heycupola"
      },
      {
        "type": "github",
        "href": "https://github.com/heycupola/wrapper"
      }
    ]
  },
  "feedback": {
    "suggestEdit": true,
    "raiseIssue": {
      "url": "https://github.com/heycupola/wrapper/issues/new"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": ["introduction", "troubleshooting"]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/installation",
          "guides/auth",
          "guides/local-attach",
          "guides/remote-share",
          "guides/mobile-viewer"
        ]
      },
      {
        "group": "Configuration",
        "pages": ["configuration/security", "configuration/environment"]
      },
      {
        "group": "Development",
        "pages": ["development/setup"]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/architecture",
          "reference/transports",
          "reference/pricing"
        ]
      }
    ]
  }
}
