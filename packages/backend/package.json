{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx convex dev",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json . --fix",
    "format": "oxfmt --ignore-path ../../.oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path ../../.oxfmtignore .",
    "check-types": "tsc --noEmit",
    "test": "bun test tests/*.test.ts && vitest run",
    "test:integration": "vitest run",
    "betterAuth:generate-schema": "cd ./convex/betterAuth && bunx @better-auth/cli@latest generate -y --output generatedSchema.ts",
    "deploy": "bunx convex deploy",
    "deploy:dry-run": "bunx convex deploy --dry-run"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@useautumn/convex": "0.0.23",
    "better-auth": "1.6.25",
    "convex": "1.42.3",
    "convex-helpers": "0.1.120"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/bun": "latest",
    "convex-test": "^0.0.54",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
