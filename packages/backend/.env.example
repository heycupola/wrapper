# Convex backend runtime
ENVIRONMENT="development"
SITE_URL="http://localhost:3000"
BETTER_AUTH_SECRET="wrapper-local-dev-secret-change-me"

# Auth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Apple Services ID and its signed client-secret JWT. Never store the .p8 key here.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
# Comma-separated primary App IDs accepted in Apple account-change notification tokens.
APPLE_NOTIFICATION_AUDIENCES="sh.wrapper.mobile"

# Billing and events
AUTUMN_SECRET_KEY=""
AUTUMN_WEBHOOK_SECRET=""
WRAPPER_AUTUMN_PRO_PLAN_ID="pro"
WRAPPER_AUTUMN_PRO_YEARLY_PLAN_ID="pro_yearly"

# Transactional email (Resend)
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
FROM_EMAIL_ADDRESS="Wrapper <notifications@wrapper.sh>"
FROM_EMAIL_ADDRESS_PERSONAL="Can from Wrapper <can@wrapper.sh>"

# Apple Push (optional; phone alerts stay off without these)
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="sh.wrapper.mobile"
APNS_KEY_P8=""
LOG_LEVEL="debug"

# Relay ticket/session tuning
WRAPPER_RELAY_HOST_TICKET_TTL_MS=30000
WRAPPER_RELAY_VIEWER_TICKET_TTL_MS=60000
WRAPPER_SESSION_STALE_AFTER_MS=300000
WRAPPER_SESSION_STALE_GRACE_MS=30000
WRAPPER_AUTUMN_RELAY_SHARE_FEATURE_ID="can_share_relay"
