{
  "name": "backend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bunx convex dev",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json . --fix",
    "format": "oxfmt --ignore-path ../../.oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path ../../.oxfmtignore .",
    "check-types": "tsc --noEmit",
    "test": "bun test ./tests && vitest run",
    "test:integration": "vitest run",
    "betterAuth:generate-schema": "cd ./convex/betterAuth && bunx @better-auth/cli@latest generate -y --output generatedSchema.ts",
    "deploy": "bunx convex deploy",
    "deploy:dry-run": "bunx convex deploy --dry-run"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/resend": "^0.2.3",
    "@react-email/components": "^1.0.2",
    "@react-email/render": "^2.0.0",
    "@useautumn/convex": "0.0.23",
    "better-auth": "1.6.26",
    "convex": "1.43.0",
    "convex-helpers": "0.1.122",
    "jose": "^6.2.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "^6.6.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/bun": "latest",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "convex-test": "^0.0.55",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
