# Workspace-level shared defaults for LOCAL development.
# For the deployed dev/prod environments and the full env matrix, see
# ENVIRONMENTS.md at the repo root.
NODE_ENV="development"

# Convex
WRAPPER_CONVEX_URL="https://your-project.convex.cloud"
CONVEX_URL="https://your-project.convex.cloud"

# Web/auth origin
SITE_URL="http://localhost:3000"
WRAPPER_AUTH_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APPLE_AUTH_ENABLED="false"

# Relay
WRAPPER_RELAY_URL="ws://localhost:8080"

# Billing entitlement (backend)
WRAPPER_AUTUMN_RELAY_SHARE_FEATURE_ID="can_share_relay"
